{
  "version": 2,
  "routes": [
    {
      "src": "/robots\\.txt",
      "dest": "/robots.txt",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/icp-review.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate",
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
